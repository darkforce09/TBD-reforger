{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeaveRequestContract",
  "description": "Leave-of-absence requests: a member files and lists their own; an administrator lists all and decides. The root is one request.",
  "$ref": "#/definitions/LeaveRequest",
  "definitions": {
    "LeaveRequest": {
      "description": "One leave-of-absence request. starts_on and ends_on are calendar dates (ends_on on or after starts_on); reason is absent only on rows stored before a reason was required; reviewed_by is the reviewing administrator's Discord id, absent while pending.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "discord_id",
        "starts_on",
        "ends_on",
        "status",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "discord_id": {
          "type": "string",
          "minLength": 1
        },
        "starts_on": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00Z$",
          "description": "A calendar date, sent as midnight UTC."
        },
        "ends_on": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00Z$",
          "description": "A calendar date, sent as midnight UTC."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "denied"
          ]
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "LeaveRequestList": {
      "description": "GET /api/v1/me/leave-requests (any signed-in member): the caller's requests, newest first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LeaveRequest"
          }
        }
      }
    },
    "LeaveRequestPage": {
      "description": "GET /api/v1/admin/leave-requests?limit=&offset= (administrator): every request, pending first, then newest first. limit defaults to 20 and is at most 100.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "total",
        "limit",
        "offset"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LeaveRequest"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "LeaveRequestSubmission": {
      "description": "POST /api/v1/me/leave-requests body; answers 201 with the LeaveRequest. Dates are YYYY-MM-DD; a blank reason answers 400.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts_on",
        "ends_on",
        "reason"
      ],
      "properties": {
        "starts_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "ends_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LeaveReview": {
      "description": "PATCH /api/v1/admin/leave-requests/:id body (administrator).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "denied"
          ]
        }
      }
    },
    "LeaveReviewOutcome": {
      "description": "PATCH /api/v1/admin/leave-requests/:id answer: the decision now stored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "denied"
          ]
        }
      }
    }
  }
}
