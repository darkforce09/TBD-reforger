{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IssuedMachineCredential",
  "description": "POST /api/v1/servers/:id/credentials (administrator). The secret authenticates exactly one executor of exactly one server and is never shown again.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential",
    "secret"
  ],
  "properties": {
    "credential": {
      "$ref": "#/definitions/MachineCredential"
    },
    "secret": {
      "type": "string",
      "pattern": "^tbdm_[0-9a-f]{32}_[0-9a-f]{64}$"
    }
  },
  "definitions": {
    "MachineCredential": {
      "description": "One issued credential: provenance, use and revocation, never the secret.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "server_id",
        "executor_kind",
        "label",
        "created_by",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "server_id": {
          "type": "string",
          "format": "uuid"
        },
        "executor_kind": {
          "$ref": "#/definitions/ExecutorKind"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_used_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_by": {
          "type": "string"
        },
        "revoke_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "ExecutorKind": {
      "type": "string",
      "enum": [
        "host_agent",
        "mod_runtime"
      ]
    },
    "MachineCredentialIssue": {
      "description": "POST /api/v1/servers/:id/credentials body.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_kind",
        "label"
      ],
      "properties": {
        "executor_kind": {
          "$ref": "#/definitions/ExecutorKind"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "MachineCredentialList": {
      "description": "GET /api/v1/servers/:id/credentials response. Revocation: DELETE /api/v1/servers/:id/credentials/:credentialId?reason=... answers the revoked MachineCredential.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MachineCredential"
          }
        }
      }
    }
  }
}
