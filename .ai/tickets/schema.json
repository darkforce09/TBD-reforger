{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TBD Ticket Registry",
  "description": "In-memory registry shape after T-911.2 encoding C (typed Scope/Status). On-disk form is T-*.toml.",
  "type": "object",
  "required": ["next_id", "tickets"],
  "additionalProperties": false,
  "properties": {
    "next_id": { "type": "integer", "minimum": 1 },
    "tickets": {
      "type": "array",
      "items": { "$ref": "#/$defs/ticket" }
    }
  },
  "$defs": {
    "ticketId": {
      "type": "string",
      "pattern": "^T-[0-9]{3}(\\.[0-9]+)*$",
      "description": "Parent ids (T-068, T-441) and dotted slice ids (T-068.15, T-181.3.1)."
    },
    "ticketIdList": {
      "type": "array",
      "items": { "$ref": "#/$defs/ticketId" }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "executor": {
      "type": "string",
      "enum": ["claude-code", "cursor-docs", "workbench", "human", "ci"]
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "queued",
        "ready",
        "running",
        "review",
        "shipped",
        "deferred",
        "cancelled"
      ]
    },
    "target": {
      "type": "string",
      "enum": ["website", "mod", "shared", "root"]
    },
    "kind": {
      "type": "string",
      "enum": ["program", "work"]
    },
    "sliceEntry": {
      "type": "object",
      "required": ["targets", "executor", "status"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target" },
          "minItems": 1
        },
        "executor": { "$ref": "#/$defs/executor" },
        "status": { "$ref": "#/$defs/status" },
        "shipped_at": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "spec": { "type": "string" }
      }
    },
    "capability": {
      "type": "string",
      "enum": ["selection", "transform", "place", "persistence", "undo", "layers"]
    },
    "editorChrome": {
      "type": "string",
      "enum": ["left", "right", "map", "top", "bottom", "attr"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "editor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chrome": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/editorChrome" }
                },
                "capability": { "$ref": "#/$defs/capability" }
              }
            },
            "page": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "route": { "type": "string" },
                "capability": { "$ref": "#/$defs/capability" }
              }
            },
            "shell": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "capability": { "$ref": "#/$defs/capability" }
              }
            },
            "backend": {
              "type": "object",
              "required": ["layers"],
              "additionalProperties": false,
              "properties": {
                "layers": {
                  "type": "array",
                  "items": { "enum": ["api", "db", "auth", "realtime"] },
                  "minItems": 1
                }
              }
            },
            "tests": {
              "type": "object",
              "required": ["layers"],
              "additionalProperties": false,
              "properties": {
                "layers": {
                  "type": "array",
                  "items": { "enum": ["unit", "integration", "gate"] },
                  "minItems": 1
                }
              }
            }
          }
        },
        "mod": {
          "type": "object",
          "required": ["layers"],
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "enum": [
                  "ui",
                  "gamemode",
                  "backend",
                  "feature",
                  "prefab",
                  "data",
                  "workbench",
                  "worlds"
                ]
              },
              "minItems": 1
            }
          }
        },
        "schema": {
          "type": "object",
          "required": ["layers"],
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "array",
              "items": { "enum": ["mission", "registry", "contract"] },
              "minItems": 1
            }
          }
        },
        "engine": {
          "type": "object",
          "required": ["layers"],
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "array",
              "items": { "enum": ["core", "render", "world"] },
              "minItems": 1
            }
          }
        },
        "repo": {
          "type": "object",
          "required": ["layers"],
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "array",
              "items": { "enum": ["ci", "docs", "xtask", "tickets"] },
              "minItems": 1
            }
          }
        }
      }
    },
    "ticket": {
      "type": "object",
      "required": ["id", "title", "summary", "kind", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ticketId" },
        "kind": { "$ref": "#/$defs/kind" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "order": { "type": "integer" },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "spec": { "type": "string" },
        "executor": { "$ref": "#/$defs/executor" },
        "notes": { "type": "string" },
        "depends_on": { "$ref": "#/$defs/ticketIdList" },
        "unblocks": { "$ref": "#/$defs/ticketIdList" },
        "parent": { "$ref": "#/$defs/ticketId" },
        "children": { "$ref": "#/$defs/ticketIdList" },
        "slices": { "$ref": "#/$defs/ticketIdList" },
        "active": { "type": ["string", "null"] },
        "active_slice": { "type": ["string", "null"] },
        "user_story": { "type": "string" },
        "acceptance": { "$ref": "#/$defs/stringList" },
        "shipped_at": { "type": "string", "minLength": 1 },
        "owns": { "$ref": "#/$defs/stringList" },
        "pack_last": { "type": "boolean" },
        "scope": { "$ref": "#/$defs/scope" },
        "slice_plan": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/ticketId" },
          "additionalProperties": { "$ref": "#/$defs/sliceEntry" }
        }
      }
    }
  }
}
