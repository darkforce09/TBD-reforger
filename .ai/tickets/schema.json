{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TBD Ticket Registry",
  "description": "In-memory registry shape after T-917.2 schema v2 (flat 4-level scope, class, typed body, provenance keys). On-disk form is T-*.toml.",
  "type": "object",
  "required": ["next_id", "tickets"],
  "additionalProperties": false,
  "properties": {
    "next_id": { "type": "integer", "minimum": 1 },
    "tickets": {
      "type": "array",
      "items": { "$ref": "#/$defs/ticket" }
    }
  },
  "$defs": {
    "ticketId": {
      "type": "string",
      "pattern": "^T-[0-9]{3}(\\.[0-9]+)*$",
      "description": "Parent ids (T-068, T-441) and dotted slice ids (T-068.15, T-181.3.1)."
    },
    "ticketIdList": {
      "type": "array",
      "items": { "$ref": "#/$defs/ticketId" }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rfc3339Utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$",
      "description": "T-913.1 lifecycle stamp: RFC 3339 UTC only (Z or +00:00, uppercase T). Deep field-range validation happens in tbd-tickets on load; malformed values refuse the tree."
    },
    "executor": {
      "type": "string",
      "enum": ["claude-code", "cursor-docs", "workbench", "human", "ci"]
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "queued",
        "ready",
        "running",
        "review",
        "shipped",
        "deferred",
        "cancelled"
      ]
    },
    "target": {
      "type": "string",
      "enum": ["website", "mod", "shared", "root"]
    },
    "kind": {
      "type": "string",
      "enum": ["program", "work"]
    },
    "sliceEntry": {
      "type": "object",
      "required": ["targets", "executor", "status"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target" },
          "minItems": 1
        },
        "executor": { "$ref": "#/$defs/executor" },
        "status": { "$ref": "#/$defs/status" },
        "shipped_at": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "spec": { "type": "string" }
      }
    },
    "class": {
      "type": "string",
      "enum": ["bug", "feature", "chore", "audit", "docs"]
    },
    "estimatedField": {
      "type": "string",
      "enum": ["created_at", "completed_at", "shipped_at", "tokens", "scope"]
    },
    "scope": {
      "type": "object",
      "required": ["domain", "layer"],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["website", "mod", "schema", "engine", "repo"]
        },
        "layer": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/stringList" }
      }
    },
    "ticket": {
      "type": "object",
      "required": ["id", "title", "summary", "kind", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ticketId" },
        "kind": { "$ref": "#/$defs/kind" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "class": { "$ref": "#/$defs/class" },
        "status": { "$ref": "#/$defs/status" },
        "order": { "type": "integer" },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "spec": { "type": "string" },
        "plan": { "type": "string" },
        "executor": { "$ref": "#/$defs/executor" },
        "notes": { "type": "string" },
        "depends_on": { "$ref": "#/$defs/ticketIdList" },
        "unblocks": { "$ref": "#/$defs/ticketIdList" },
        "parent": { "$ref": "#/$defs/ticketId" },
        "children": { "$ref": "#/$defs/ticketIdList" },
        "slices": { "$ref": "#/$defs/ticketIdList" },
        "active": { "type": ["string", "null"] },
        "active_slice": { "type": ["string", "null"] },
        "user_story": { "type": "string" },
        "main_goal": { "type": "string" },
        "context": { "$ref": "#/$defs/stringList" },
        "requirement": { "$ref": "#/$defs/stringList" },
        "current_state": { "$ref": "#/$defs/stringList" },
        "approach": { "$ref": "#/$defs/stringList" },
        "verify": { "$ref": "#/$defs/stringList" },
        "acceptance": { "$ref": "#/$defs/stringList" },
        "citations": { "$ref": "#/$defs/stringList" },
        "shipped_at": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "#/$defs/rfc3339Utc" },
        "completed_at": { "$ref": "#/$defs/rfc3339Utc" },
        "estimated": {
          "type": "array",
          "items": { "$ref": "#/$defs/estimatedField" }
        },
        "estimate_note": { "type": "string" },
        "migration_legacy": { "$ref": "#/$defs/stringList" },
        "owns": { "$ref": "#/$defs/stringList" },
        "pack_last": { "type": "boolean" },
        "scope": { "$ref": "#/$defs/scope" },
        "slice_plan": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/ticketId" },
          "additionalProperties": { "$ref": "#/$defs/sliceEntry" }
        }
      }
    }
  }
}
