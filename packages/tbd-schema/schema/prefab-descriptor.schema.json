{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tbd.example/schema/prefab-descriptor.schema.json",
  "title": "TBD Prefab BLAS Descriptor",
  "description": "T-090.12.2 — one catalogue prefab's collision closure (`prefabs/descriptors/<prefabId>.json`): the root mesh as an instance record at identity (kind `shell` for buildings, the walker's classification otherwise) plus every collision-bearing child the prefab slots in, each with its `.bvh` sidecar under `blas/` and a rigid transform in the prefab's object frame (Enfusion x, y up, z; metres; unit quaternion [x, y, z, w]); or `blocks: false` with a reason when nothing in the closure collides. Emitted by `cargo xtask map bvh-batch --all-prefabs`; the Rust source of truth is `map_engine_core::world::occluder::descriptor`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "prefabId", "slug", "resourceName", "kind", "blocks", "canopy", "shellBvh", "instances"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "prefabId": { "type": "integer", "minimum": 0 },
    "slug": { "type": "string", "minLength": 1 },
    "resourceName": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "blocks": { "type": "boolean" },
    "reason": { "type": "string", "enum": ["no-mesh", "model-unreadable", "no-coll", "empty-coll", "unresolved"] },
    "canopy": { "type": "boolean" },
    "localBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vec3" },
        "max": { "$ref": "#/$defs/vec3" }
      }
    },
    "shellBvh": { "type": "string" },
    "instances": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "localTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pos", "quat"],
      "properties": {
        "pos": { "$ref": "#/$defs/vec3" },
        "quat": { "$ref": "#/$defs/quat" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "required": ["angleRangeDeg", "closedAngleDeg", "initialAngleDeg"],
      "properties": {
        "angleRangeDeg": { "type": "number" },
        "closedAngleDeg": { "type": "number" },
        "initialAngleDeg": { "type": "number" },
        "angleRangeExplicit": { "type": "boolean" },
        "openedDistance": { "type": "number" }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "prefab", "blas", "local", "cover", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["shell", "doorLeaf", "doorFrame", "windowFrame", "glass", "furniture", "tree", "treeCanopy", "prop"] },
        "prefab": { "type": "string", "minLength": 1 },
        "blas": { "type": "string", "pattern": "^blas/.+\\.bvh$" },
        "xob": { "type": "string" },
        "local": { "$ref": "#/$defs/localTransform" },
        "door": { "$ref": "#/$defs/door" },
        "cover": { "type": "string", "enum": ["full", "low", "none"] },
        "source": { "type": "string", "enum": ["xobSocket", "recon", "prefabCoords", "scene"] },
        "parent": { "type": "string" }
      }
    }
  }
}
