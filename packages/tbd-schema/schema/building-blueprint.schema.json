{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.tbdevent.eu/building-blueprint/v1.json",
  "title": "TBD Building Architectural Blueprint",
  "description": "High-fidelity architectural definition of a building prefab including multi-floor layouts, exact non-rectangular wall polylines, selectable openings (doors, windows, glass), unselectable internal geometry (stairs, partitions), furniture props, and vertical profiles for line-of-sight.",
  "type": "object",
  "required": [
    "schemaVersion",
    "prefabId",
    "resourceName",
    "kind",
    "category",
    "destructible",
    "verticalProfile",
    "overallFootprint",
    "levels"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0"] },
    "prefabId": { "type": "string", "minLength": 1 },
    "resourceName": { "type": "string", "minLength": 1 },
    "modelMesh": { "type": "string" },
    "label": { "type": "string" },
    "kind": { "type": "string", "enum": ["building"] },
    "category": {
      "type": "string",
      "enum": ["residential", "military", "commercial", "industrial", "civic", "sheds_garages", "generic"]
    },
    "destructible": { "type": "boolean" },
    "verticalProfile": {
      "type": "object",
      "required": ["pivotElevationOffsetM", "foundationSkirtDepthM", "totalHeightM", "eaveHeightM", "ridgeHeightM", "roofType"],
      "additionalProperties": false,
      "properties": {
        "pivotElevationOffsetM": { "type": "number" },
        "foundationSkirtDepthM": { "type": "number", "minimum": 0 },
        "totalHeightM": { "type": "number", "minimum": 0 },
        "eaveHeightM": { "type": "number", "minimum": 0 },
        "ridgeHeightM": { "type": "number", "minimum": 0 },
        "chimneyHeightM": { "type": "number", "minimum": 0 },
        "roofType": { "type": "string" }
      }
    },
    "overallFootprint": {
      "type": "object",
      "required": ["polygon2D", "boundingBox2D", "footprintSqM"],
      "additionalProperties": false,
      "properties": {
        "polygon2D": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "boundingBox2D": {
          "type": "object",
          "required": ["min", "max", "widthM", "depthM"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "max": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "widthM": { "type": "number", "minimum": 0 },
            "depthM": { "type": "number", "minimum": 0 }
          }
        },
        "footprintSqM": { "type": "number", "minimum": 0 }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["levelIndex", "name", "elevationRange", "sliceHeightM", "footprintPolygon", "walls", "doors", "windows", "stairs", "furniture"],
        "additionalProperties": false,
        "properties": {
          "levelIndex": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "elevationRange": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "sliceHeightM": { "type": "number" },
          "footprintPolygon": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          },
          "walls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "start", "end", "thickness", "isExterior", "material"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "start": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "end": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "thickness": { "type": "number", "minimum": 0 },
                "isExterior": { "type": "boolean" },
                "material": { "type": "string" }
              }
            }
          },
          "doors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "prefabResource", "wallId", "pos2D", "widthM", "heightM", "hingeSide", "swingDirection", "isExterior", "hasGlass", "defaultState"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "prefabResource": { "type": "string" },
                "wallId": { "type": "string" },
                "pos2D": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "widthM": { "type": "number", "minimum": 0 },
                "heightM": { "type": "number", "minimum": 0 },
                "hingeSide": { "type": "string", "enum": ["left", "right", "center", "none"] },
                "swingDirection": { "type": "string", "enum": ["inward", "outward", "sliding", "both", "none"] },
                "isExterior": { "type": "boolean" },
                "hasGlass": { "type": "boolean" },
                "defaultState": { "type": "string", "enum": ["open", "closed", "locked", "destroyed"] }
              }
            }
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "prefabResource", "wallId", "pos2D", "widthM", "sillHeightM", "windowHeightM", "normal", "fovDeg", "hasGlass", "glassPaneCount"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "prefabResource": { "type": "string" },
                "wallId": { "type": "string" },
                "pos2D": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "widthM": { "type": "number", "minimum": 0 },
                "sillHeightM": { "type": "number", "minimum": 0 },
                "windowHeightM": { "type": "number", "minimum": 0 },
                "normal": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "fovDeg": { "type": "number", "minimum": 0, "maximum": 360 },
                "hasGlass": { "type": "boolean" },
                "glassPaneCount": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "stairs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "bounds", "connectsToLevel", "directionDeg", "stepCount", "transparentSteps", "losConcealment"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "bounds": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
                },
                "connectsToLevel": { "type": "integer" },
                "directionDeg": { "type": "number" },
                "stepCount": { "type": "integer", "minimum": 1 },
                "transparentSteps": { "type": "boolean" },
                "losConcealment": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "furniture": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "category", "prefabResource", "pos2D", "rotationDeg", "size2D", "heightM", "blocksMovement", "losCover"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "category": { "type": "string", "enum": ["table", "chair", "bed", "storage", "seating", "appliance", "crate", "prop"] },
                "prefabResource": { "type": "string" },
                "pos2D": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "rotationDeg": { "type": "number" },
                "size2D": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "heightM": { "type": "number", "minimum": 0 },
                "blocksMovement": { "type": "boolean" },
                "losCover": { "type": "string", "enum": ["none", "low_cover", "full_cover"] }
              }
            }
          }
        }
      }
    }
  }
}
