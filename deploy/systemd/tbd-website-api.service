; The website API unit. `cargo xtask deploy website` restarts this by name
; (TBD_WEBSITE_SYSTEMD_UNIT, default tbd-website-api.service) after building the release binary
; on the server.
;
; Install: substitute TBD_REPO_DIR_PLACEHOLDER for the deploy's TBD_REMOTE_DIR (no leading slash
; in the placeholder — the slash is already in the paths below), drop the result at
; ~/.config/systemd/user/tbd-website-api.service, then:
;   systemctl --user daemon-reload && systemctl --user enable --now tbd-website-api.service
;
; ── WHY THE ASSET DIRECTORIES ARE SET EXPLICITLY ────────────────────────────────────────────
;
; Only a development boot defaults MAP_ASSETS_DIR and GLYPH_ASSETS_DIR, to the checkout's
; `assets/terrains` and `assets/glyphs` under the root it finds by walking up from the working
; directory. Outside development the API refuses to boot unless both are named absolutely, and
; `ServeDir` performs no I/O when constructed, so a wrong root would produce a 404 per request
; and nothing at all in the journal. Both are therefore pinned to absolute paths here.
; WorkingDirectory is the API server's crate folder; the settings file loaded below is
; deploy/api.env, the same file the API's own lookup finds under the checkout root from there.
;
; The terrain tree is NOT rsynced by the deploy (it is ~590 MB of LFS content); the server keeps
; its own copy, and `cargo xtask deploy website` refuses to run while that copy still sits at the
; older packages/map-assets. The glyph atlas IS rsynced — it is 188 KB and tracked.
;
; ── WHY THE RUNTIME DIRECTORIES ARE SET EXPLICITLY ──────────────────────────────────────────
;
; The API writes CMS uploads (served back at /uploads) and the equipment datasets it imports, with
; their indexes. Outside development it refuses to boot unless UPLOAD_DIR is named absolutely, and
; refuses an EQUIPMENT_DATA_DIR that is set but relative, so that what it writes never lands inside
; the checkout the deploy rsyncs with --delete. systemd creates %S/tbd-website-api
; (StateDirectory=); the API creates uploads/ at boot and equipment/ on its first import.
;
; The settings file loaded below must leave MAP_ASSETS_DIR, GLYPH_ASSETS_DIR, UPLOAD_DIR and
; EQUIPMENT_DATA_DIR out: systemd lets an EnvironmentFile= value override an Environment= line for
; the same variable, so a path set there replaces the pin here, and a relative UPLOAD_DIR or
; EQUIPMENT_DATA_DIR stops the boot outside development.

[Unit]
Description=TBD Reforger website API
Documentation=file:///TBD_REPO_DIR_PLACEHOLDER/documentation/runbooks/website_deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/TBD_REPO_DIR_PLACEHOLDER/crates/api/api_server

; Server-only secrets. Never rsynced from a dev PC: both deploys exclude this path, and each
; refuses to rsync while the host lacks it.
EnvironmentFile=/TBD_REPO_DIR_PLACEHOLDER/deploy/api.env

; Served at /map-assets and /map-assets/glyphs. See the note above before changing either.
Environment=MAP_ASSETS_DIR=/TBD_REPO_DIR_PLACEHOLDER/assets/terrains
Environment=GLYPH_ASSETS_DIR=/TBD_REPO_DIR_PLACEHOLDER/assets/glyphs

; What the API writes lives under the unit's state directory, never in the checkout. See the
; note above; `%S` is $XDG_STATE_HOME (~/.local/state) for a user unit.
StateDirectory=tbd-website-api
Environment=UPLOAD_DIR=%S/tbd-website-api/uploads

; The imported equipment datasets and their indexes: runtime storage like the uploads, so absolute
; outside development. Leave EQUIPMENT_DATA_DIR out of deploy/api.env; a value there overrides this
; line.
Environment=EQUIPMENT_DATA_DIR=%S/tbd-website-api/equipment

ExecStart=/TBD_REPO_DIR_PLACEHOLDER/target/release/api-server

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
