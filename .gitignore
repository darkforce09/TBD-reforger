# Ticket pipeline worktrees (git worktree add — not committed; see worktrees/README.md)
.ai/artifacts/worktrees/TBD-*/
# T-181 slice worktrees (docs/mod/SLICE_WORKFLOW.md). These are live git checkouts; staging
# them makes git treat each as an embedded repository, which breaks clones. The older rule
# above only covers `TBD-*`, so slice names like `T-181.7` slipped through.
.ai/artifacts/worktrees/T-*/

apps/mod/crf_framework/

# Staging deploy secrets (copy from scripts/deploy/deploy.env.example)
scripts/deploy/deploy.env

# Python bytecode caches (ticket/migration scripts)
__pycache__/
*.pyc

# T-090.3.0 map-export staging (local scratch — proof lives in committed ops log + verifiers)
packages/map-assets/**/staging/

# Satellite/map tile pyramids — local build output (make map-water-everon / build-tile-pyramid.sh)
# DEM + unified .tbd-sat stay in Git LFS; pyramid is optional fallback (T-090.1.2.8).
packages/map-assets/**/tiles/

# scripts/mod npm deps (enfusion-mcp — install via npm ci in scripts/mod/)
scripts/mod/node_modules/

# Local enfusion-mcp IDE config (machine paths — see docs/mod/CLAUDE-CODE-START.md)
.cursor/mcp.json
.mcp.json
apps/mod/.cursor/mcp.json

# Cargo workspace build dir (T-145: the workspace root owns /target for every member crate).
/target/
/target-ci/

# map-engine wasm-pack output — regenerated by `make wasm` (pkg/ already carries a `*` .gitignore).
.compile-load-baseline
.compile-vanilla-baseline
