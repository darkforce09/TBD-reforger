# ==============================================================================
# 1. Version Control & Worktrees
# ==============================================================================
# Ticket pipeline worktrees (git worktree add — not committed; see worktrees/README.md)
.ai/artifacts/worktrees/TBD-*/
# Slice worktrees (documentation/runbooks/mod_slice_workflow.md). Live checkouts;
# staging one causes git to treat it as an embedded repository.
.ai/artifacts/worktrees/T-*/

# ==============================================================================
# 2. Environment & Secrets
# ==============================================================================
.env
.env.*
!.env.example
tools/xtask/deploy/deploy.env

# ==============================================================================
# 3. Editor & OS Cruft
# ==============================================================================
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
# Local enfusion-mcp IDE config (machine paths — see documentation/runbooks/mod_slice_workflow.md)
.mcp.json

# ==============================================================================
# 4. Global Dependencies, Caches & Logs
# ==============================================================================
node_modules/
__pycache__/
*.pyc
*.log

# ==============================================================================
# 5. Rust / Cargo Build Directories
# ==============================================================================
# All build output: the target directory shared across worktrees and its purpose
# subfolders (dev-api, ci, gate-*)
/target/
# Retired root-level build folders: local folders no tool writes any more, which
# `cargo xtask platform wave reclaim` deletes where a machine still holds them
/target-ci/
/target-dev-api/
/target-gate-*/
/dist-gate-*/
# Per-slice and hand-set target directories (target-<ticket id>, target-container)
target-*/

# ==============================================================================
# 6. Website Suite (apps/website)
# ==============================================================================
# Trunk frontend build outputs
/apps/website/frontend/dist/
/apps/website/frontend/dist-debug/

# ==============================================================================
# 7. Mod Suite (apps/mod)
# ==============================================================================
# Oracle lanes & reference sources (NO trailing slashes: in worktrees these are symlinks,
# and trailing slashes would allow symlinks to be staged)
/apps/mod/crf_framework
/apps/mod/vanilla_reference
/apps/mod/playable_selector
/apps/mod/Tbd_framework

# Local dedicated-server dev profile (generated by setup-server-profile.sh)
/apps/mod/.local-test-profile/

# Enfusion script-compile baselines, regenerated by `cargo xtask mod compile`
.compile-load-baseline
.compile-vanilla-baseline

# Workbench/Workshop publish build outputs (regenerated; never commit)
/apps/mod/tbd-framework/UserMaps.desc
/apps/mod/tbd-framework/data.pak
/apps/mod/tbd-framework/*.pak
/apps/mod/tbd-framework/*_manifest.json
/apps/mod/tbd-framework/ServerData.json
/apps/mod/tbd-framework/meta

# Mod helper scripts (Rust raster pipeline replaced these)
apps/mod/tbd-export/tools/*.mjs

# ==============================================================================
# 8. Assets & Pipeline Intermediates (assets/)
# ==============================================================================
# Map-export scratch (local intermediates)
assets/scratch/
# Satellite/map tile pyramids
assets/terrains/**/tiles/

# Equipment viewer originals and rebuildable disk indexes
/assets/equipment/

# ==============================================================================
# 9. Tooling & Pipeline Artifacts (.ai/, tools/)
# ==============================================================================
# Ticket engine trybuild test output
/tools/ticket_engine/wip/

# T-159 gate run artifacts only (regenerable)
/.ai/artifacts/t159_gates/v/
/.ai/artifacts/t159_gates/logs/
/.ai/artifacts/t159_gates/.devtoken

# Wave gate receipts & execution evidence
/.ai/artifacts/last-verified
/.ai/artifacts/verdicts/
