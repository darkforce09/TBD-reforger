# Ticket pipeline worktrees (git worktree add — not committed; see worktrees/README.md)
.ai/artifacts/worktrees/TBD-*/
# Slice worktrees (documentation_v2/runbooks/mod_slice_workflow.md). These are live git checkouts; staging one
# makes git treat it as an embedded repository, which breaks clones. The rule above covers
# only `TBD-*`, so dotted slice names need their own rule.
.ai/artifacts/worktrees/T-*/

apps/mod/crf_framework/

# Website and staging deploy secrets (copy from tools_v2/xtask/deploy/deploy.env.example)
tools_v2/xtask/deploy/deploy.env

# Python bytecode caches
__pycache__/
*.pyc

# Map-export scratch (local intermediates — the proof lives in the committed ops log + verifiers)
assets_v2/scratch/

# Satellite/map tile pyramids — local build output (`cargo run -p developer-tools --bin map`).
# The DEM and the unified .tbd-sat stay in Git LFS; the pyramid is an optional fallback.
assets_v2/terrains/**/tiles/

# Local enfusion-mcp IDE config (machine paths — see documentation_v2/runbooks/mod_slice_workflow.md)
.cursor/mcp.json
.mcp.json
apps/mod/.cursor/mcp.json

# Cargo workspace build dir: the workspace root owns /target for every member crate, and
# `cargo xtask mk` derives CARGO_TARGET_DIR as the primary repository's /target (shared across
# worktrees). Do not commit any target tree.
/target/
# CI scratch dir no recipe writes to. Safe reclaim: `cargo xtask mk reclaim-target-ci`
# (never deletes the warm shared /target).
/target-ci/

# Enfusion script-compile baselines, regenerated by `cargo xtask mod compile`.
.compile-load-baseline
.compile-vanilla-baseline
# Per-slice gate target dir for the wave "test frontend" step. A shared CARGO_TARGET_DIR lets one
# worktree run another's stale website_frontend test binary.
target-gate-frontend/

# Private per-slice/verify target dirs. Agents create these so the shared CARGO_TARGET_DIR
# cannot serve a stale cross-worktree binary. They belong to nobody and must never be committed.
target-*/

# Wave-gate private trunk output (the wave gate's trunk step)
/dist-gate-frontend/
/target-gate-trunk/
/.ai/artifacts/last-verified

# LANG-1/2/3 hard zero: the raster pipeline is Rust. The mod author's two node helper scripts
# stay on disk and out of git.
apps/mod/tbd-export/tools/*.mjs

# Node dependency trees are installed, never committed.
node_modules/
