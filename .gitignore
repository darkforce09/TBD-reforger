# ==============================================================================
# 1. Version Control & Worktrees
# ==============================================================================
# Every linked git worktree of this checkout (git worktree add), one folder per worktree. Live
# checkouts; staging one makes git treat it as an embedded repository.
/.worktrees/

# One machine's local state: logs, run records, tool roots (the Enfusion MCP game root, the
# playtest server, extracted game files) and the host-bridge wrappers. Never committed.
/.workstation/

# ==============================================================================
# 2. Environment & Secrets
# ==============================================================================
.env
.env.*
!.env.example
deploy/deploy.env
deploy/api.env

# ==============================================================================
# 3. Editor & OS Cruft
# ==============================================================================
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
# Machine-local agent configuration (absolute paths of this workstation)
.mcp.json
/.claude/settings.local.json
/.claude/launch.json

# ==============================================================================
# 4. Global Dependencies, Caches & Logs
# ==============================================================================
node_modules/
__pycache__/
*.pyc
*.log

# ==============================================================================
# 5. Rust / Cargo Build Directories
# ==============================================================================
# All build output: one target folder shared across worktrees, with one subfolder per toolchain
# environment (target/host, target/container) and the purpose subfolders inside each
/target/

# ==============================================================================
# 6. Frontend Build Output (crates/frontend/shell/frontend_application)
# ==============================================================================
# Trunk frontend build outputs
/crates/frontend/shell/frontend_application/dist/
/crates/frontend/shell/frontend_application/dist-debug/

# ==============================================================================
# 7. Mod Suite (mod/)
# ==============================================================================
# Upstream reference lanes (licensed; never committed): everything in the folder but its README.
# NO trailing slash: in slice worktrees the lanes are symlinks, which a slash would not match.
/mod/References/*
!/mod/References/README.md
/mod/Tbd_framework

# Local dedicated-server dev profile (generated by setup-server-profile.sh)
/mod/.local-test-profile/

# Enfusion script-compile baselines, regenerated by `cargo xtask mod compile`
.compile-load-baseline
.compile-vanilla-baseline

# Workbench/Workshop publish build outputs (regenerated; never commit)
/mod/tbd-framework/UserMaps.desc
/mod/tbd-framework/data.pak
/mod/tbd-framework/*.pak
/mod/tbd-framework/*_manifest.json
/mod/tbd-framework/ServerData.json
/mod/tbd-framework/meta

# ==============================================================================
# 8. Assets & Pipeline Intermediates (assets/)
# ==============================================================================
# Map-export scratch (local intermediates)
assets/scratch/
# Satellite/map tile pyramids
assets/terrains/**/tiles/

# Equipment viewer originals and rebuildable disk indexes
/assets/equipment/

# ==============================================================================
# 9. Tooling (tools/)
# ==============================================================================
