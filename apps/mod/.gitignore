# --- Heavy / generated: never commit ---
**/node_modules/

# --- CRF reference: do-not-ship copy (see CLAUDE-CODE-START.md) ---
/Tbd_framework/
# NO trailing slash: slice worktrees get these as SYMLINKS to the main tree (the oracle
# sources are gitignored, so a fresh worktree would otherwise have neither). A trailing
# slash matches directories only and lets the symlink itself be staged — which would commit
# an absolute machine-specific path into the repo.
/crf_framework

# --- T-181.3 carved vanilla Enfusion source: Bohemia Interactive copyrighted game
#     content, regenerated on demand by `enf carve`. NEVER COMMIT. Only the derived
#     symbol index (.ai/artifacts/enf-index/vanilla_*.tsv) is committable.
/vanilla_reference

# --- T-181.52 PlayableSelector oracle lane. Same NO-trailing-slash rule as the two above:
#     slice-worktree.sh links this in as a SYMLINK, and a trailing slash would let the link
#     itself be staged — committing an absolute, machine-specific path into the repo.
#     PlayableSelector carries NO LICENCE, so committing any of it would also be a licence
#     breach. DESIGN-MIRROR ONLY; `make verify-no-crf-leak` gates the PS_ prefix.
/playable_selector

# --- Local dedicated-server dev profile (generated by setup-server-profile.sh) ---
/.local-test-profile/

# --- Enfusion MCP bridge handlers (dev-only, re-injected by the MCP) ---
tbd-framework/Scripts/WorkbenchGame/EnfusionMCP/
tbd-framework/UserMaps.desc

# --- Logs / OS / editor cruft ---
*.log
.DS_Store

# --- Staging deploy secrets: relocated to repo-root scripts/deploy/deploy.env (see root .gitignore) ---

# Workbench/Workshop publish build outputs (regenerated; never commit)
tbd-framework/data.pak
tbd-framework/*.pak
tbd-framework/*_manifest.json
tbd-framework/ServerData.json
tbd-framework/meta
