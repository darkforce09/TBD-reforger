# The home server's web site: the built Leptos app, with the API's paths proxied to the API.
#
# Served by the `caddy` service of apps/website/docker-compose.staging.yml, which mounts this
# folder read-only at /etc/tbd-caddy and apps/website/frontend read-only at /srv/tbd-frontend, so
# the paths below are the container's. `cargo xtask deploy website` rsyncs this file, starts the
# service and runs `caddy reload` on it, so an edit here reaches the host with the next deploy.
#
# A Cloudflare Tunnel targets http://127.0.0.1:3080 (documentation_v2/runbooks/website_deployment.md
# Phase E).
#
# COOP/COEP match Trunk.toml / gate serve — required for Mission Creator wasm
# SharedArrayBuffer (crossOriginIsolated).

:3080 {
	# Mission Creator wasm / SharedArrayBuffer parity with `trunk serve`
	header Cross-Origin-Opener-Policy same-origin
	header Cross-Origin-Embedder-Policy credentialless

	# The offline service worker loader revalidates on every update check, so a new build's
	# worker is found on the next visit.
	header /service_worker.js Cache-Control no-cache

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /uploads/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /map-assets/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /srv/tbd-frontend/dist
		try_files {path} /index.html
		file_server
	}
}
