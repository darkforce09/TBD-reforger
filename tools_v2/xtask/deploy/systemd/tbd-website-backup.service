; Nightly verified database backup for the TBD website.
;
; A USER unit, not root cron, to match the API: `cargo xtask deploy website` restarts
; `tbd-website-api.service` via `systemctl --user`, and `cargo xtask deploy staging`
; installs its unit into ~/.config/systemd/user. Root cron would run as the wrong user,
; would not see the deploy user's podman socket (rootless containers live in the user
; session), and would write backups nobody else can read.
;
; Install (on the deploy host, as the deploy user):
;   mkdir -p ~/.config/systemd/user
;   sed 's|/TBD_REPO_DIR_PLACEHOLDER|/home/sam/tbd/TBD-Reforger|' \
;       tools_v2/xtask/deploy/systemd/tbd-website-backup.service \
;       > ~/.config/systemd/user/tbd-website-backup.service
;   cp tools_v2/xtask/deploy/systemd/tbd-website-backup.timer ~/.config/systemd/user/
;   systemctl --user daemon-reload
;   systemctl --user enable --now tbd-website-backup.timer
;   loginctl enable-linger $USER        # REQUIRED: without it the timer stops at logout
;
; Verify:  systemctl --user list-timers tbd-website-backup.timer
;          journalctl --user -u tbd-website-backup.service -n 50
;
; ── Why the placeholder is an ABSOLUTE path (the leading `/`) ────────────────────────
; `systemd-analyze verify --user` rejects a `WorkingDirectory=` that is not absolute, so a
; bare `TBD_REPO_DIR_PLACEHOLDER` would make this committed template fail verification even
; though the template is correct for what it is. `/TBD_REPO_DIR_PLACEHOLDER` is a
; syntactically valid absolute path, so the template verifies clean, and the `sed` above
; matches the leading slash so the rendered unit carries the real repository path.
;
; This does NOT let a naive `cp`-install pass silently. The unit starts, fails at once, and
; names the placeholder in the journal:
;   Changing to the requested working directory "/TBD_REPO_DIR_PLACEHOLDER": No such file
;   or directory
; — the failure is self-explanatory and is raised at the point where it is actionable. Do
; not "tidy up" the leading slash.

[Unit]
Description=TBD website — verified PostgreSQL backup
Documentation=file:///TBD_REPO_DIR_PLACEHOLDER/tools_v2/xtask/src/commands/deploy/database_backup.rs
; The dump goes through `podman exec`, so the container stack has to be up. This orders
; against it when present and does not require it, because the backup script already
; refuses loudly (and non-zero) when the container is missing or not running — a refusal
; that is visible in the journal is better than a unit that silently never starts.
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/TBD_REPO_DIR_PLACEHOLDER

; Retention is BY COUNT. 14 nightly dumps ~= two weeks of history that cannot be silently
; emptied by a stopped timer — see the long comment in tools_v2/xtask/src/commands/deploy/database_backup.rs. Override per host by
; editing this line, not by adding a `find -mtime` sweep somewhere else.
Environment=TBD_BACKUP_KEEP=14
Environment=TBD_BACKUP_DB=tbd_reforger
Environment=TBD_BACKUP_DIR=%h/tbd-backups/website
Environment=TBD_DB_CONTAINER=tbd_reforger_db

ExecStart=/usr/bin/env cargo run -q -p xtask -- deploy db backup

; A failed backup must be loud and must NOT be retried into a tight loop — the timer will
; come back tomorrow, and the common causes (container down, disk full) are not fixed by
; retrying in 30 seconds.
Restart=no
TimeoutStartSec=1800

; The backup contains every row in the database. Keep it to the owner.
UMask=0077
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
