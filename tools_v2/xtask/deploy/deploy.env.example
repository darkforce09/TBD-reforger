# Copy to tools_v2/xtask/deploy/deploy.env (gitignored, never rsynced) and fill in values.
#
# One file names the staging host: TBD_SSH_HOST below. Nothing else in the repository writes its
# name or address, so a moved host is one edit here.
#
# How the commands read this file: KEY=VALUE lines, parsed and never executed (no $(...), no $VAR
# expansion). `export ` is allowed; a value may be quoted with "..." or '...'; a comment goes on its
# own line. This file decides every key it assigns, and an empty assignment counts as unset; the
# process environment fills only the keys this file never assigns, so optional keys stay commented
# out below. An explicit command-line flag (such as `debug a2s-probe --host`) beats both.
# DEPLOY_ENV=<path> points every command at another file.
#
# What reads it:
#   cargo xtask deploy website       website rsync, remote build and restart
#   cargo xtask deploy staging       game server deploy; hands this file's path to mod remote-logs
#   cargo xtask mod bootstrap-staging  host discovery and the remote folders
#   cargo xtask mod remote-logs      the game server's console.log verdict
#   cargo xtask debug direct-join    join probes (the remote probe, ping and A2S)
#   cargo xtask debug a2s-probe      the host to query when --host is not given
#   cargo xtask setup client-addons  the Direct Join hint it prints last
#
# Dev PC prereqs: rsync, ssh (sshpass only with TBD_SSH_PASS), Rust toolchain (~/.cargo/bin)

# SSH: user@host. The host answers as <hostname>.local through avahi (mDNS); the user is the deploy
# account, whose home the remote folders below default under.
TBD_SSH_HOST=sam@dooley.local
# A password through sshpass, else an identity file for `ssh -i`, else plain ssh (agent or keys).
# TBD_SSH_PASS=
# TBD_SSH_IDENTITY_FILE=

# Remote folders. Unset, each defaults under the deploy user's home, /home/<user> from TBD_SSH_HOST;
# set them only when the host keeps them elsewhere. With no user in TBD_SSH_HOST they are required.
# `deploy website` refuses a TBD_REMOTE_DIR outside /home/<user>/tbd/ (trailing slashes ignored,
# ".." refused) and "prairielearn", in any case, in TBD_REMOTE_DIR, TBD_SSH_HOST or TBD_PROFILE_DIR;
# `deploy staging` and `mod bootstrap-staging` refuse "prairielearn" in TBD_REMOTE_DIR.
# Default /home/<user>/tbd/repo:
# TBD_REMOTE_DIR=
# Default /home/<user>/tbd/profile:
# TBD_PROFILE_DIR=
# Default /home/<user>/tbd/addons-staging:
# TBD_ADDONS_STAGING=
# Default /home/<user>/steam/arma-reforger-server:
# TBD_SERVER_DIR=

# Game + API. The mod authenticates every API call with its machine credential below.
TBD_BACKEND_URL=http://127.0.0.1:8080
# The game runtime's machine credential (tbdm_...): Server Control -> credentials -> issue a
# "mod_runtime" credential for this server. The mod reads its deployment with it; the mission it
# runs is chosen by deploying an approved mission to this server (Server Control -> deployments).
TBD_MOD_RUNTIME_CREDENTIAL=

# Host agent (fleet-host-agent): process control, RCON reads and mission restarts for this server.
# With TBD_INSTALL_HOST_AGENT=1 the deploy builds and installs it as a user service, which needs a
# "host_agent" credential and an RCON password (3 to 256 bytes, no whitespace, no quotes); the
# rendered server config gets a loopback rcon block with that password.
# TBD_INSTALL_HOST_AGENT=0
# TBD_HOST_AGENT_CREDENTIAL=
# TBD_RCON_PASSWORD=
# TBD_RCON_PORT=19999
# Defaults to TBD_BACKEND_URL:
# TBD_HOST_AGENT_API_URL=http://127.0.0.1:8080

# Enfusion (see tbd-framework/addon.gproj and `cargo xtask mod dev-server`)
TBD_ADDON_GUID=B2C3D4E5F6A78901
TBD_SCENARIO={69A85365FC09E2CA}Missions/TBD_Dev_POC.conf

# Server launch mode:
#   config (default) — -config (registers a backend room; IS joinable). Requires the mod
#                      to be PUBLISHED to the Workshop and TBD_WORKSHOP_MOD_ID set below.
#                      The host agent's mission restarts rewrite this config's scenarioId.
#   addons           — -server + -addons (local mod). Headless log verification only;
#                      NOT Direct-Joinable (registers no backend room).
TBD_SERVER_MODE=config
# The real Workshop modId of tbd-framework (required when mode=config):
# TBD_WORKSHOP_MOD_ID=

# Networking. a2sPort MUST differ from bindPort or the server can't start replication.
# TBD_GAME_PORT=2001
# TBD_A2S_PORT=17777
# The address the backend room advertises (publicAddress). Unset, it is the first IPv4 address
# TBD_SSH_HOST resolves to on the dev PC at deploy time, and the deploy stops when there is none;
# set it only when players reach the host at another address.
# TBD_PUBLIC_ADDRESS=

# config-mode server identity (optional overrides)
# TBD_SERVER_NAME=TBD Staging POC
# TBD_ADMIN_PASSWORD=tbd-admin
# TBD_MAX_PLAYERS=64

# In-game admins for the #tbd mission browser — comma-separated game identityIds
# (printed in the server log as "Authenticated player: ... identityId=<uuid>").
# TBD_ADMIN_IDENTITY_IDS=

# ── Website deploy (`cargo xtask deploy website`) ─────────────────────────────
# Optional: host Postgres port if 5432 is taken on the server (docker-compose.staging.yml)
TBD_POSTGRES_HOST_PORT=5432
# TBD_WEBSITE_SYSTEMD_UNIT=tbd-website-api.service
#
# Map assets. The deploy does NOT rsync the terrain tree (~590 MB of LFS content) — the server
# keeps its own copy — and `cargo xtask deploy website` refuses to run when that copy is missing
# or sits at `packages/map-assets` instead of the tree the unit pins. The glyph atlas IS rsynced.
#
# MAP_ASSETS_DIR and GLYPH_ASSETS_DIR are not read from this file: they belong to the API process,
# and are set on the unit at tools_v2/xtask/deploy/systemd/tbd-website-api.service. They are
# pinned to absolute paths there because the API's fallback resolves them against its working
# directory, and a wrong root serves 404 silently rather than failing to boot.
#
# Steps to skip, each when set to 1. TBD_SKIP_COMPOSE skips both compose steps (Postgres, and the
# Caddy web server with its Caddyfile reload); TBD_SKIP_SPA_BUILD skips only the app build, and
# Caddy keeps serving the build already on the server.
# TBD_SKIP_COMPOSE=0
# TBD_SKIP_SPA_BUILD=0
# TBD_SKIP_API_BUILD=0
#
# Website one-liner (from repo root, after filling this file):
#   cargo xtask deploy website --dry-run
#   cargo xtask deploy website
#
# Staging compose validate / up (local or on server):
#   docker compose -f apps/website/docker-compose.staging.yml config
#   docker compose -f apps/website/docker-compose.staging.yml up -d postgres caddy
#   docker compose -f apps/website/docker-compose.staging.yml --profile api up -d --build
#
# Caddy (SPA + COOP/COEP + /api → :8080): tools_v2/xtask/deploy/Caddyfile.website, served by the
# compose file's caddy service, which `cargo xtask deploy website` starts and reloads.
# API image: docker build -f apps/website/Dockerfile -t tbd-website-api .
