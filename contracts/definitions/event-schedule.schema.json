{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventScheduleContract",
  "description": "The event schedule: the list of events a viewer may see, and the administrator's event and mission-attachment writes. The event hub itself is event-hub.schema.json. The root is the list page.",
  "$ref": "#/definitions/EventListPage",
  "definitions": {
    "EventListPage": {
      "description": "GET /api/v1/events?scope=&limit=&offset= (any signed-in member): the events the viewer may see. scope upcoming (the default: future or live), past (newest first) or all. total counts the visible events; limit defaults to 20 and is at most 100.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "total",
        "limit",
        "offset"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EventListItem"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "EventListItem": {
      "description": "One event with its slot usage as this viewer may see it: mission_count counts the attached missions shown, total_slots and filled the shown seats, registered the active reservations on shown missions, percent = filled * 100 / total_slots rounded down (0 without seats).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_time",
        "status",
        "registration_locked",
        "max_slots",
        "created_by",
        "created_at",
        "updated_at",
        "mission_count",
        "registered",
        "filled",
        "total_slots",
        "percent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name_override": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "briefing": {
          "type": "string",
          "minLength": 1
        },
        "banner_image_url": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/definitions/EventStatus"
        },
        "registration_locked": {
          "type": "boolean"
        },
        "max_slots": {
          "type": "integer"
        },
        "created_by": {
          "type": "string"
        },
        "server_id": {
          "type": "string",
          "format": "uuid"
        },
        "modpack_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "mission_count": {
          "type": "integer",
          "minimum": 0
        },
        "registered": {
          "type": "integer",
          "minimum": 0
        },
        "filled": {
          "type": "integer",
          "minimum": 0
        },
        "total_slots": {
          "type": "integer",
          "minimum": 0
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "Event": {
      "description": "One event row, as POST /api/v1/events (201) and PATCH /api/v1/events/:id answer it. name_override, briefing and banner_image_url are absent when empty; server_id and modpack_id are absent when unset.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_time",
        "status",
        "registration_locked",
        "max_slots",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name_override": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "briefing": {
          "type": "string",
          "minLength": 1
        },
        "banner_image_url": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/definitions/EventStatus"
        },
        "registration_locked": {
          "type": "boolean"
        },
        "max_slots": {
          "type": "integer"
        },
        "created_by": {
          "type": "string"
        },
        "server_id": {
          "type": "string",
          "format": "uuid"
        },
        "modpack_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventStatus": {
      "type": "string",
      "enum": [
        "scheduled",
        "open",
        "locked",
        "live",
        "completed",
        "cancelled"
      ]
    },
    "EventMission": {
      "description": "POST /api/v1/events/:id/missions answer (201): the attached mission and its start time.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event_id",
        "mission_id",
        "start_time",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "mission_id": {
          "type": "string",
          "format": "uuid"
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventCreation": {
      "description": "POST /api/v1/events body (administrator). start_time is required; an absent status creates a scheduled event.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_time"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "name_override": {
          "type": "string"
        },
        "briefing": {
          "type": "string"
        },
        "banner_image_url": {
          "type": "string"
        },
        "max_slots": {
          "type": "integer",
          "minimum": 0
        },
        "registration_locked": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/definitions/EventStatus"
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "modpack_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "EventChange": {
      "description": "PATCH /api/v1/events/:id body (administrator): an absent key leaves its field unchanged; server_id and modpack_id null clear the link.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "max_slots": {
          "type": "integer",
          "minimum": 0
        },
        "name_override": {
          "type": "string"
        },
        "briefing": {
          "type": "string"
        },
        "banner_image_url": {
          "type": "string"
        },
        "registration_locked": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/definitions/EventStatus"
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "modpack_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "EventMissionAttachment": {
      "description": "POST /api/v1/events/:id/missions body (administrator): the mission, its start time and the ORBAT squads to seat; an empty orbat seats the mission's own ORBAT.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "start_time"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "format": "uuid"
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "orbat": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrbatSquadTemplate"
          }
        }
      }
    },
    "OrbatSquadTemplate": {
      "description": "One squad of an ORBAT template: its faction join key, callsign, squad name and slots.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "faction": {
          "type": "string"
        },
        "callsign": {
          "type": "string"
        },
        "squad": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrbatSlotTemplate"
          }
        }
      }
    },
    "OrbatSlotTemplate": {
      "description": "One slot of an ORBAT squad template.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "role": {
          "type": "string"
        },
        "loadout": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    }
  }
}
