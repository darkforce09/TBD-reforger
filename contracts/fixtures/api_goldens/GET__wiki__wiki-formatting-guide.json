    {
      "inlines": [
        {
          "text": "Start a line with one to six ",
          "type": "text"
        },
        {
          "text": "#",
          "type": "code"
        },
        {
          "text": " characters and a space. Every heading gets an anchor made from its text: ",
          "type": "text"
        },
        {
          "text": "## Radio nets",
          "type": "code"
        },
        {
          "text": " is linked as ",
          "type": "text"
        },
        {
          "text": "#radio-nets",
          "type": "code"
        },
        {
          "text": ", and a repeated heading gets ",
          "type": "text"
        },
        {
          "text": "-2",
          "type": "code"
        },
        {
          "text": ", ",
          "type": "text"
        },
        {
          "text": "-3",
          "type": "code"
        },
        {
          "text": " and so on.",
          "type": "text"
        }
      ],
      "type": "paragraph"
    },
