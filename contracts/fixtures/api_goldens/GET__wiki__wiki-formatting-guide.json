    {
      "inlines": [
        {
          "text": "Start a quote with ",
          "type": "text"
        },
        {
          "text": "> [!NOTE]",
          "type": "code"
        },
        {
          "text": ", ",
          "type": "text"
        },
        {
          "text": "> [!TIP]",
          "type": "code"
        },
        {
          "text": ", ",
          "type": "text"
        },
        {
          "text": "> [!IMPORTANT]",
          "type": "code"
        },
        {
          "text": ", ",
          "type": "text"
        },
        {
          "text": "> [!INFO]",
          "type": "code"
        },
        {
          "text": ", ",
          "type": "text"
        },
        {
          "text": "> [!WARNING]",
          "type": "code"
        },
        {
          "text": ", ",
          "type": "text"
        },
        {
          "text": "> [!CAUTION]",
          "type": "code"
        },
        {
          "text": " or ",
          "type": "text"
        },
        {
          "text": "> [!CRITICAL]",
          "type": "code"
        },
        {
          "text": " on its own line, then write the callout on the lines below, each starting with ",
